# ============================================================
# FlowGuard Agent — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# OpenAI / OpenAI-compatible API Key
OPENAI_API_KEY=your-api-key-here

# Optional: Override base URL for OpenAI-compatible providers
# Uncomment and set to use Qwen, DeepSeek, MiMo, OpenRouter, SiliconFlow, etc.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Examples for other providers (add corresponding provider config in agent.config.json):
# QWEN_API_KEY=your-qwen-key
# DEEPSEEK_API_KEY=your-deepseek-key
# GEMINI_API_KEY=your-gemini-key
# OPENROUTER_API_KEY=your-openrouter-key
# SILICONFLOW_API_KEY=your-siliconflow-key
